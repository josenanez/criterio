        ]
      },
      "salida": {
        "muestra": "inventario, preguntas, primera posición de caja",
        "escribe": [
          ".criterio/tesoreria/<entidad>/config.json",
          "<estado>/ (init)",
          ".criterio/terminos/ (aceptar)",
          "<estado>/tesoreria/<AAAA-MM>/resultados.json",
          "<estado>/tesoreria/<AAAA-MM>/reporte-<comando>.md",
          "<raíz>/_CRITERIO_FINANZAS.txt (marcar-raiz, con permiso)"
